100 REM LOOPTRACE5.BAS (CORRECTED)
110 REM PURPOSE: CROSS-CHECK EVERY AL(AL,1) ACTIVITY-CODE GATE
120 REM FOUND IN DIVER.BAS AGAINST THE CONFIRMED MAPPING AT
130 REM LINE 780 (DATA DESCEND,ASCEND,WORK,DECOMPRESS,REST),
140 REM READ VIA LINES 720-760 (FOR J=1 TO 5:READ A$(J):NEXT J).
150 REM STANDALONE - DOES NOT RUN THE FULL DIVER.BAS.
160 REM
170 REM FIX (THIS VERSION): ORIGINAL PRINT USED COMMA-SEPARATED
180 REM ZONES, WHICH "DECOMPRESS" (10 CHARS) OVERRAN, MISALIGNING
190 REM ROW 4 AGAINST THE HEADER. THIS VERSION PRINTS EACH ROW
200 REM ACROSS SHORT FIXED-FORMAT LINES INSTEAD, IMMUNE TO LABEL
210 REM LENGTH. SEE LOG.md, 05 JULY 2026.
220 REM
230 DIM A$(5)
240 FOR J=1 TO 5
250 READ A$(J)
260 NEXT J
270 DATA DESCEND,ASCEND,WORK,DECOMPRESS,REST
280 REM
290 FOR AL1 = 1 TO 5
300 REM [1888] IF AL(AL,1)=4 THEN GOSUB 7500
310 X1$ = "NO" : IF AL1 = 4 THEN X1$ = "YES"
320 REM [3540] IF AL(AL,1)=4 THEN GOSUB 6800
330 X2$ = "NO" : IF AL1 = 4 THEN X2$ = "YES"
340 REM [3017] IF AL(AL,1)=3 THEN GOSUB 6200
350 X3$ = "NO" : IF AL1 = 3 THEN X3$ = "YES"
360 REM [6751] I=AL(AL,1): IF I<>1 AND I<>3 THEN 6799
370 X4$ = "NO" : IF AL1 = 1 OR AL1 = 3 THEN X4$ = "YES"
380 REM [3021] IF AL(AL,1)<>5 THEN 3025  (activity-prompt stub fires)
390 X5$ = "NO" : IF AL1 <> 5 THEN X5$ = "YES"
400 REM [3400/3402] IF AL(AL,1)<>1 AND AL(AL,1)<>2 THEN 3410
410 REM         IF AL(AL,1)=2 THEN 3406   (branch taken when =2)
420 X6$ = "NO" : IF AL1 = 2 THEN X6$ = "YES"
430 PRINT "----"
440 PRINT "N="; AL1; " "; A$(AL1)
450 PRINT " G7500="; X1$
460 PRINT " G6800="; X2$
470 PRINT " G6200="; X3$
480 PRINT " 6751P="; X4$
490 PRINT " 3025S="; X5$
500 PRINT " 3406B="; X6$
505 INPUT Y$
510 NEXT AL1
520 PRINT "----"
530 PRINT
540 PRINT "EXPECT G7500/G6800=YES ONLY ROW 4 (DECOMPRESS)."
550 PRINT "EXPECT G6200=YES ONLY ROW 3 (WORK)."
560 PRINT "EXPECT 6751P=YES ONLY ROWS 1,3 (DESCEND,WORK)."
570 PRINT "EXPECT 3025S=YES ALL EXCEPT ROW 5 (REST)."
580 PRINT "EXPECT 3406B=YES ONLY ROW 2 (ASCEND)."
590 PRINT
600 PRINT "NOT TESTED - NEEDS LIVE MQ/MP FROM A REAL DIVE:"
610 PRINT "[6316] IF AL(AL,1)=1 AND MQ>MP THEN 6599"
620 PRINT "[6317] IF AL(AL,1)=2 AND MP>MQ THEN 6599"
630 PRINT "[6312] IF AL(AL,1)=3 THEN 6330"
640 END
