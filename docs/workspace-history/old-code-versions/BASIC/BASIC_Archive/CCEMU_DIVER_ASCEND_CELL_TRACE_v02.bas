10 REM EXACT DIVER 6320 ASCEND-CELL TRACE V02 FOR CCEMU
20 REM BUILDS THE FINAL WORK DISPLAY, THEN SENDS SIX LITERAL ASCEND VECTORS
30 REM CCEMU CII REFRESH RAM: 64X32 CELLS, BASE 24576, TWO BYTES PER CELL
40 CLEAR 300
50 DIM C(7),DT(21,7),AL(15,7),SV(216),SA(216),BV(36),BA(36)
60 C(1)=20:C(2)=23:C(3)=18:C(4)=22:C(5)=19:C(6)=17:C(7)=16
70 FOR I=1 TO 21
80 FOR J=1 TO 7
90 READ DT(I,J)
100 NEXT J
110 NEXT I
120 PLOT 6,39,12,15
130 XS=2:YS=2:TK=.25:LM=12:AL=1:AL(1,1)=3
140 AA=1.5:CL=20:BB=40:GOSUB 6300
150 AA=20:CL=21.75:BB=40:GOSUB 6300
155 GOSUB 8900
160 AL(1,1)=2
170 P=1:AA=21.75:CL=21.75:BB=40:AD=36.25:GOSUB 6300:GOSUB 9000
180 P=2:AA=21.75:CL=22:BB=36.25:AD=32.5:GOSUB 6300:GOSUB 9000
190 P=3:AA=22:CL=22.25:BB=32.5:AD=28.75:GOSUB 6300:GOSUB 9000
200 P=4:AA=22.25:CL=22.5:BB=28.75:AD=25:GOSUB 6300:GOSUB 9000
210 P=5:AA=22.5:CL=22.75:BB=25:AD=21.25:GOSUB 6300:GOSUB 9000
220 P=6:AA=22.75:CL=23:BB=21.25:AD=17.5:GOSUB 6300:GOSUB 9000
230 GOSUB 9200
240 END
400 DATA 232,431,999,999,999,999,999
420 DATA 137,140,159,179,201,229,270
440 DATA 96,98,106,116,125,134,144
460 DATA 72,73,81,88,94,99,105
480 DATA 57,59,66,71,76,80,84
500 DATA 46,49,55,60,63,67,70
520 DATA 38,42,47,51,55,58,999
540 DATA 32,37,41,45,48,51,999
560 DATA 27,32,37,40,43,45,999
580 DATA 23,29,33,36,39,41,999
600 DATA 20,25,30,33,35,37,999
620 DATA 18,23,27,30,32,34,999
640 DATA 16,21,25,28,30,31,999
660 DATA 14,20,23,26,27,29,999
680 DATA 12,18,21,24,26,27,999
700 DATA 11,17,20,22,24,25,999
720 DATA 10,16,19,21,22,24,999
740 DATA 9,15,18,20,21,999,999
760 DATA 8,14,17,18,20,999,999
780 DATA 8,13,16,17,999,999,999
800 DATA 7,12,15,17,999,999,999
6300 REM ORIGINAL DIVER SUB COLOURED BANDS
6310 LP=INT(AA*XS)+10:LQ=INT(CL*XS)+10
6312 IF AL(AL,1)=3 THEN 6330
6313 MP=140-INT(BB*YS):MQ=140-INT(AD*YS)
6314 IF LQ<LM THEN 6599
6315 LM=LQ
6316 IF AL(AL,1)=1 AND MQ>MP THEN 6599
6317 IF AL(AL,1)=2 AND MP>MQ THEN 6599
6320 PLOT 6,32,29,2,253,LP,MP,242,LQ,MQ,255:GOTO 6599
6330 Y3=INT(140-BB*YS)
6331 FOR X3=LP TO LQ
6332 IF X3<=LM THEN 6593
6333 LM=X3:XX=(X3-10)/XS-TK
6345 Y2=140:C=1
6346 L=1:CO=1
6350 FOR J=1 TO 7
6355 PLOT 30,20
6360 FOR I=L TO 21
6370 IF DT(I,J)=999 OR DT(I,J)<XX THEN 6380
6375 NEXT I
6380 Y1=INT(140-(2*I+8)*YS)
6381 Y1=Y1+2:IF Y1=42 THEN Y1=40
6385 IF Y1<40 THEN Y1=40
6390 IF Y3<Y1 OR Y3>Y2 THEN 6500
6400 CO=C
6500 IF C=1 THEN 6540
6510 PLOT 29,C(C)
6525 PLOT 2,246,Y1,X3,Y2,255
6540 IF Y1=40 OR C=7 THEN 6590
6541 IF DT(I,J)=999 THEN 6590
6550 Y2=Y1-1
6560 C=C+1
6565 L=I
6570 NEXT J
6590 PLOT 30,C(CO),29,16,29
6591 PLOT 2,253,X3,Y3,255
6593 NEXT X3
6599 RETURN
8900 REM CAPTURE COMPLETED-WORK BASELINE BEFORE ASCEND
8910 FOR K=0 TO 11
8920 R=31-INT((60+K*4)/4)
8930 FOR Q=0 TO 2
8940 Z=K*3+Q+1:A=24576+2*(R*64+26+Q)
8950 BV(Z)=PEEK(A):BA(Z)=PEEK(A+1)
8960 NEXT Q
8970 NEXT K
8980 RETURN
9000 REM CAPTURE COLUMNS 26-28, LOGICAL Y GROUPS 60-107
9010 FOR K=0 TO 11
9020 R=31-INT((60+K*4)/4)
9030 FOR Q=0 TO 2
9040 Z=(P-1)*36+K*3+Q+1:A=24576+2*(R*64+26+Q)
9050 SV(Z)=PEEK(A):SA(Z)=PEEK(A+1)
9060 NEXT Q
9070 NEXT K
9080 RETURN
9200 REM PRINT ONLY CELLS WHOSE CH/AT CHANGED IN EACH PASS
9210 PLOT 6,39,12,15
9220 PLOT 3,0,0:PRINT "LITERAL 6320 ASCEND - CHANGED CCEMU CELLS";
9230 W=2
9240 FOR P=1 TO 6
9250 PLOT 3,0,W:PRINT "PASS";P;:W=W+1:N=0
9260 FOR K=0 TO 11
9270 FOR Q=0 TO 2
9280 Z=(P-1)*36+K*3+Q+1
9290 IF P>1 THEN 9294
9292 VC=BV(K*3+Q+1):VA=BA(K*3+Q+1):GOTO 9300
9294 VC=SV(Z-36):VA=SA(Z-36)
9300 IF SV(Z)=VC AND SA(Z)=VA THEN 9370
9310 V=SV(Z):GOSUB 9500:U$=O$:V=SA(Z):GOSUB 9500
9320 PLOT 3,2,W:PRINT "C";26+Q;" Y";60+K*4;" ";U$;"/";O$;:W=W+1:N=N+1
9330 IF W>44 THEN 9400
9370 NEXT Q
9380 NEXT K
9390 IF N=0 THEN PLOT 3,2,W:PRINT "NO BYTE CHANGE";:W=W+1
9395 NEXT P
9400 PLOT 3,0,W+1:PRINT "SEND THIS ONE SCREEN";
9410 PLOT 3,0,W+3:PRINT "READY";
9420 RETURN
9500 REM TWO-DIGIT HEX STRING FOR V=0..255
9510 H$="0123456789ABCDEF"
9520 O$=MID$(H$,INT(V/16)+1,1)+MID$(H$,V-INT(V/16)*16+1,1)
9530 RETURN
